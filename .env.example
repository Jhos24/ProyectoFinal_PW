# Configuración de Base de Datos SQL Server (SQL Server Authentication)
# NOTA: No se debe incluir el puerto según los requerimientos del proyecto.
DB_SERVER=localhost
DB_DATABASE=mi_base_de_datos
DB_USER=mi_usuario_sql
DB_PASSWORD=mi_password_sql
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
